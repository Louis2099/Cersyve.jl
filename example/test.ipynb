   "source": [
    "task = Unicycle4D\n",
    "\n",
    "value_hidden_sizes = [32, 32]\n",
    "dynamics_hidden_sizes = [32, 32]\n",
    "constraint_hidden_sizes = [16]\n",
    "\n",
    "\n",
    "data_path = joinpath(@__DIR__, \"../data/unicycle4D_data.jld2\")\n",
    "model_dir = joinpath(@__DIR__, \"../model/unicycle4D/\")\n",
    "log_dir = joinpath(@__DIR__, \"../log/unicycle4D/\")\n",
    "\n",
    "seed = 1\n",
    "\n",
    "Random.seed!(seed)\n",
    "\n",
    "if !isfile(data_path)\n",
    "    collect_data(\n",
    "        task.x_low,\n",
    "        task.x_high,\n",
    "        task.u_low,\n",
    "        task.u_high,\n",
    "        task.dynamics,\n",
    "        task.terminated;\n",
    "        save_path=data_path,\n",
    "    )\n",
    "end\n",
    "\n",
    "\n",
    "# non linear dynamic\n",
    "data = JLD2.load(data_path)[\"data\"]\n",
    "f_model = Cersyve.create_mlp(task.x_dim + task.u_dim, task.x_dim, dynamics_hidden_sizes)\n",
    "Flux.loadmodel!(f_model, JLD2.load(joinpath(model_dir, \"f.jld2\"), \"state\"))\n",
    "\n",
    "dynamics_model = Cersyve.create_non_linear_dynamics_model(f_model, data, task.x_low, task.x_high, task.u_dim, task.x_dim)\n",
    "\n",
    "# calculate the error between the model prediction and actual dynamics\n",
    "test_state = uniform(task.x_low, task.x_high, 1000)\n",
    "test_action = uniform(task.u_low, task.u_high, 1000)\n",
    "\n",
    "ref_x_prime = task.dynamics(test_state, test_action)\n",
    "x_prime = dynamics_model([test_state; test_action])\n",
    "wrong_x_prime = f_model([test_state; test_action])\n",
    "\n",
    "mse_error = sum(abs.(x_prime - ref_x_prime)) / length(x_prime)\n",
    "wrong_error = sum(abs.(wrong_x_prime - ref_x_prime)) / length(wrong_x_prime)\n",
    "println(\"error: \", mse_error)\n",
    "println(\"wrong error: \", wrong_error)\n",
    "\n",
    "# sample one transition and plot the result\n",
    "test_state = uniform(task.x_low, task.x_high, 1)\n",
    "test_action = uniform(task.u_low, task.u_high, 1)\n",
    "ref_x_prime = task.dynamics(test_state, test_action)\n",
    "x_prime = dynamics_model([test_state; test_action])\n",
    "wrong_x_prime = f_model([test_state; test_action])\n",
    "\n",
    "println(\"test_state: \", test_state)\n",
    "println(\"test_action: \", test_action)\n",
    "\n",
    "println(\"ref x_prime: \", ref_x_prime)\n",
    "println(\"x_prime: \", x_prime)\n",
    "println(\"wrong x_prime: \", wrong_x_prime)\n",
    "\n"
   ]
